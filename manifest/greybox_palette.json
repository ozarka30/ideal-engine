{
  "id": "greybox.palette",
  "note": "Six hues intended to be sampled from the GuttyKreum Office Interior palette at ~35% saturation, ~55% value. The hex values here are placeholders at those targets; Phase 4's first task replaces them with sampled values (Q-GBX-3, Q-GBX-5) without changing the structure. 'invalid' is deliberately outside the palette.",
  "tones": {
    "structure": {
      "fill": "#6f6a62",
      "border": "#4f4b45",
      "hatch": "#8a847b",
      "text": "#1c1a17",
      "source": "wall/floor neutrals"
    },
    "operations": {
      "fill": "#5f8a86",
      "border": "#43625f",
      "hatch": "#7aa39f",
      "text": "#14201f",
      "source": "desk teal"
    },
    "people": {
      "fill": "#9a6f78",
      "border": "#6e4f56",
      "hatch": "#b28a92",
      "text": "#23181b",
      "source": "uniform rose"
    },
    "support": {
      "fill": "#9a8a5c",
      "border": "#6e6242",
      "hatch": "#b3a578",
      "text": "#221f14",
      "source": "cabinet ochre"
    },
    "interface": {
      "fill": "#5f6a7a",
      "border": "#434b57",
      "hatch": "#7a8595",
      "text": "#e8e6e1",
      "source": "terminal slate"
    },
    "anomalous": {
      "fill": "#7a5f8a",
      "border": "#574362",
      "hatch": "#957aa3",
      "text": "#1c1420",
      "source": "horror-pack violet"
    },
    "invalid": {
      "fill": "#e0202a",
      "border": "#8a0e15",
      "hatch": "#ff5c64",
      "text": "#ffffff",
      "source": "none — deliberately outside the palette"
    }
  },
  "rendering": {
    "footprintAlpha": 850,
    "overhangAlpha": 450,
    "borderPx": 1,
    "hatchPitchPx": 4,
    "labelFont": "font.ui.8",
    "labelFallback": [
      "id+footprint+dims",
      "id",
      "dot"
    ],
    "dotSize": 4
  }
}
