{
  "modifiers": [
    {
      "id": "mod.overtime_culture",
      "name": "Overtime Culture",
      "text": "Every employee starts each fight with 1 Burnout and 1 Overtime.",
      "rivalOnly": false,
      "boardMeeting": {
        "cost": "1 Burnout on everyone at Quarter Open",
        "benefit": "1 Overtime on everyone at Quarter Open"
      },
      "effects": [
        {
          "on": "banner",
          "do": "status",
          "status": "status.burnout",
          "stacks": 1,
          "target": {
            "side": "own",
            "scope": "all"
          },
          "month": 0
        },
        {
          "on": "banner",
          "do": "status",
          "status": "status.overtime",
          "stacks": 1,
          "target": {
            "side": "own",
            "scope": "all"
          },
          "month": 0
        }
      ]
    },
    {
      "id": "mod.lean",
      "name": "Lean",
      "text": "Goodwill cap −200; income +¥2 per round.",
      "rivalOnly": false,
      "boardMeeting": {
        "cost": "−200 Goodwill cap",
        "benefit": "+¥2 income per round"
      },
      "effects": [
        {
          "on": "static",
          "do": "stat",
          "stat": "goodwillCap",
          "subject": {
            "scope": "firm"
          },
          "amount": -200
        },
        {
          "on": "economy",
          "do": "stat",
          "stat": "income",
          "subject": {
            "scope": "firm"
          },
          "amount": 2
        }
      ]
    },
    {
