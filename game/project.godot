; Engine configuration file.
; Pixel discipline per ARCHITECTURE.md §7: 640x360 logical canvas, viewport stretch, integer scale,
; nearest filtering, pixel snapping, Compatibility renderer, X11 on Linux.

config_version=5

[application]

config/name="Company Wars"
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

ScreenRouter="*res://scenes/Router.tscn"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
display_server/driver.linuxbsd="x11"
window/handheld/orientation=4

[dotnet]

project/assembly_name="CompanyWars.Game"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
textures/vram_compression/import_etc2_astc=true
