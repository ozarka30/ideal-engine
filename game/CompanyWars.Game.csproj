<Project Sdk="Godot.NET.Sdk/4.7.2">
  <!-- The client (ARCHITECTURE.md §2, §7). References the libraries; nothing references this project.
       The client assembly targets net9.0 because Godot 4.7's Android export template is built for it; the
       libraries stay net8.0 (D-60) and are referenced across the version line without change. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>CompanyWars.Game</RootNamespace>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../src/CompanyWars.Sim/CompanyWars.Sim.csproj" />
    <ProjectReference Include="../src/CompanyWars.Content/CompanyWars.Content.csproj" />
    <ProjectReference Include="../src/CompanyWars.Manifest/CompanyWars.Manifest.csproj" />
    <ProjectReference Include="../src/CompanyWars.Playback/CompanyWars.Playback.csproj" />
    <ProjectReference Include="../src/CompanyWars.Build/CompanyWars.Build.csproj" />
  </ItemGroup>
</Project>
