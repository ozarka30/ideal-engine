[gd_scene format=3]

[ext_resource type="Texture2D" path="res://assets/ui/ui/build/floor_frame.png" id="1"]
[ext_resource type="TileSet" path="res://assets/packs/japanese_office_interior.tres" id="2"]

; B1 — Portal, the basic company (D-84). 160 x 96 at 1x, the floor's slot on the build screen,
; drawn live at 2x like a room; greyed and LOCKED until the portal opens. The grid is 3 x 3 tiles of
; 32 px from (0, 0); the rest of the slot is outside the floor, and the game hatches it as void over
; this. Paint the look on `Tiles` -- it is half scale, so a cell is 16 px, as in a room scene -- and
; delete `frame` when the paint covers it. What the floor is (grid, output, room kinds, lease) stays
; in tools/planning/gen_content.py.
